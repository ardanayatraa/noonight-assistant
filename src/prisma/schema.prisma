generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Client {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @db.Char(36)
  name        String    @db.VarChar(255)
  company     String?   @db.VarChar(255)
  email       String?   @db.VarChar(255)
  whatsappNumber String @unique @map("whatsapp_number") @db.VarChar(30)
  status      ClientStatus @default(active)
  workspaceRoot String? @map("workspace_root") @db.VarChar(500)
  settings    Json?
  // Prepaid request quota: each AI question spends 1; admin tops it up.
  requestBalance Int    @default(25) @map("request_balance")
  requestsUsed   Int    @default(0)  @map("requests_used")
  // Which repo the user is currently talking to (for WhatsApp context switching)
  activeProjectId BigInt? @map("active_project_id")
  activeProject   Project? @relation("ActiveProject", fields: [activeProjectId], references: [id], onDelete: SetNull)
  projects    Project[]
  agent       Agent?
  memories    ClientMemory[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([uuid])
  @@index([whatsappNumber])
  @@index([status])
  @@index([activeProjectId])
  @@map("clients")
}

// Per-user Hermes agent: one agent owned by a client, serves all their repos.
model Agent {
  id           BigInt   @id @default(autoincrement())
  uuid         String   @unique @db.Char(36)
  clientId     BigInt   @unique @map("client_id")
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String   @default("Hermes") @db.VarChar(100)
  persona      String?  @db.Text
  provider     String?  @db.VarChar(50)
  model        String?  @db.VarChar(100)
  temperature  Float    @default(0.3)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("agents")
}

// Per-user memory: shared across all of a client's repos.
model ClientMemory {
  id          BigInt    @id @default(autoincrement())
  clientId    BigInt    @map("client_id")
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  key         String    @db.VarChar(255)
  value       String?   @db.Text
  type        MemoryType @default(knowledge)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([clientId, key])
  @@index([clientId])
  @@index([type])
  @@map("client_memory")
}

enum ClientStatus {
  active
  suspended
  archived
}

model Project {
  id            BigInt    @id @default(autoincrement())
  uuid          String    @unique @db.Char(36)
  clientId      BigInt    @map("client_id")
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String    @db.VarChar(255)
  repoUrl       String    @map("repo_url") @db.VarChar(1000)
  repoProvider  RepoProvider @default(github) @map("repo_provider")
  repoVisibility RepoVisibility @default(public) @map("repo_visibility")
  branch        String    @default("main") @db.VarChar(255)
  framework     String?   @db.VarChar(100)
  frameworkConfidence Float? @map("framework_confidence")
  status        ProjectStatus @default(cloning)
  workspacePath String?   @map("workspace_path") @db.VarChar(500)
  githubTokenEncrypted String? @map("github_token_encrypted") @db.Text
  githubWebhookSecret  String? @map("github_webhook_secret") @db.VarChar(255)
  aiProviderOverride   String? @map("ai_provider_override") @db.VarChar(50)
  aiModelOverride      String? @map("ai_model_override") @db.VarChar(100)
  rateLimitPerMinute   Int     @default(10) @map("rate_limit_per_minute")
  sessionTimeoutMinutes Int    @default(30) @map("session_timeout_minutes")
  lastSyncedAt         DateTime? @map("last_synced_at")
  sessions      Session[]
  aiMemory      AiMemory[]
  conversations Conversation[]
  activeForClients Client[] @relation("ActiveProject")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([uuid])
  @@index([clientId, status])
  @@map("projects")
}

enum RepoProvider {
  github
  gitlab
  bitbucket
}

enum RepoVisibility {
  public
  private
}

enum ProjectStatus {
  cloning
  ready
  error
  indexing
}

model Session {
  id            BigInt    @id @default(autoincrement())
  uuid          String    @unique @db.Char(36)
  projectId     BigInt    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform      SessionPlatform @default(whatsapp)
  identifier    String    @db.VarChar(255)     // WhatsApp number or web session ID
  status        SessionStatus @default(active)
  aiProvider    String?   @map("ai_provider") @db.VarChar(50)
  aiModel       String?   @map("ai_model") @db.VarChar(100)
  totalTokens   Int       @default(0) @map("total_tokens")
  expiresAt     DateTime  @map("expires_at")
  lastActivityAt DateTime @map("last_activity_at")
  conversations Conversation[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([uuid])
  @@index([identifier])
  @@index([expiresAt])
  @@map("sessions")
}

enum SessionPlatform {
  whatsapp
  web
  api
}

enum SessionStatus {
  active
  expired
  terminated
}

model Conversation {
  id            BigInt    @id @default(autoincrement())
  sessionId     BigInt    @map("session_id")
  session       Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  projectId     BigInt    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String?   @db.VarChar(255)
  messageCount  Int       @default(0) @map("message_count")
  totalTokens   Int       @default(0) @map("total_tokens")
  messages      Message[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([sessionId])
  @@map("conversations")
}

model Message {
  id              BigInt    @id @default(autoincrement())
  conversationId  BigInt    @map("conversation_id")
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String    @db.Text
  tokenCount      Int       @default(0) @map("token_count")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

enum MessageRole {
  user
  assistant
  system
}

model AiMemory {
  id          BigInt    @id @default(autoincrement())
  projectId   BigInt    @map("project_id")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key         String    @db.VarChar(255)
  value       String?   @db.Text
  type        MemoryType @default(knowledge)
  ttlMinutes  Int?      @map("ttl_minutes")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([projectId, key])
  @@index([type])
  @@map("ai_memory")
}

enum MemoryType {
  preference
  knowledge
  context
  system
}

model AiProvider {
  id        BigInt    @id @default(autoincrement())
  name      String    @unique @db.VarChar(50)
  provider  String    @db.VarChar(50)
  model     String    @db.VarChar(100)
  apiKey    String    @map("api_key") @db.Text   // encrypted
  baseUrl   String?   @map("base_url") @db.VarChar(500)
  isActive  Boolean   @default(true) @map("is_active")
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("ai_providers")
}

model AuditLog {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt?   @map("user_id")
  action    String    @db.VarChar(100)
  entity    String    @db.VarChar(100)
  entityId  BigInt?   @map("entity_id")
  details   Json?
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model User {
  id            BigInt    @id @default(autoincrement())
  uuid          String    @unique @db.Char(36)
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  role          UserRole  @default(admin)
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@map("users")
}

enum UserRole {
  admin
  manager
  viewer
}

model Setting {
  id        BigInt    @id @default(autoincrement())
  key       String    @unique @db.VarChar(255)
  value     String    @db.Text
  category  String?   @db.VarChar(50)
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([category])
  @@map("settings")
}
