# ============================================================
# Noonight Assistant — Environment Configuration
# ============================================================

# Application
NODE_ENV=production
APP_SECRET=change-me-to-random-64-char-string
APP_URL=http://localhost:3001
PORT=3001

# Database (MySQL — configurable from Dashboard after setup)
DATABASE_URL=mysql://noonight:changeme@localhost:3306/noonight

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage paths
WORKSPACE_ROOT=/workspaces
STORAGE_ROOT=/storage

# ============================================================
# AI Providers (add keys below — can also be configured via Dashboard)
# ============================================================
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-claude-key
GEMINI_API_KEY=your-gemini-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key
