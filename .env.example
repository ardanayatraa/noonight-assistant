# ============================================================
# Noonight Assistant — Environment Configuration
# ============================================================

# Application
NODE_ENV=production
APP_SECRET=change-me-to-random-64-char-string
APP_URL=http://localhost:3001
PORT=3001

# Database (MySQL — configurable from Dashboard after setup)
# Pool tuning lives in the query string for fast, efficient connections:
#   connection_limit — max pooled connections (raise for concurrency; keep <= MySQL max_connections)
#   pool_timeout     — seconds to wait for a free connection before erroring
#   connect_timeout  — seconds to wait for the initial TCP/handshake
DATABASE_URL=mysql://noonight:changeme@localhost:3306/noonight?connection_limit=10&pool_timeout=20&connect_timeout=10

# Log queries slower than SLOW_QUERY_MS (only when PRISMA_LOG_QUERIES=true)
PRISMA_LOG_QUERIES=false
SLOW_QUERY_MS=500

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage paths
WORKSPACE_ROOT=/workspaces
STORAGE_ROOT=/storage

# ============================================================
# AI Providers (add keys below — can also be configured via Dashboard)
# ============================================================
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-claude-key
GEMINI_API_KEY=your-gemini-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key
